[FRONTEND_VERCEL]

# ── Vercel static site ──────────────────────────────────────────────────────────
# Public HTTPS origin used for login/OAuth redirects and API calls.
VITE_API_URL=https://<your-frontend-host>/api/v1

# Same origin that serves the built SPA.
VITE_APP_URL=https://<your-frontend-host>
