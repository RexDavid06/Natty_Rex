# ── Django ────────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# Local development uses SQLite when DATABASE_URL is empty.
DATABASE_URL=
# PostgreSQL for production / docker compose:
# DATABASE_URL=postgres://nattyrex:change-me@localhost:5432/nattyrex
# Neon: use the pooled URL for the app and the unpooled URL for migrations.
# DATABASE_URL=postgresql://user:pass@ep-...-pooler.region.aws.neon.tech/db?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-....region.aws.neon.tech/db?sslmode=require

# Used by docker-compose.yml to create the database and build DATABASE_URL.
POSTGRES_DB=nattyrex
POSTGRES_USER=nattyrex
POSTGRES_PASSWORD=replace-with-a-url-safe-password
WEB_PORT=80

# ── URLs / CORS ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_SSL_REDIRECT=False

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
INVITATION_TTL_DAYS=7
# JWT_SIGNING_KEY=optional-separate-signing-key

# ── Media ─────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=100
# MEDIA_ROOT defaults to backend/media; set an absolute path if needed.
# MEDIA_ROOT=/srv/nattyrex/media
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_QUERYSTRING_AUTH=True
# CLOUDINARY_URL=

# ── Email (console in development) ───────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Nattyrex <no-reply@example.com>
# SMTP example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
# Production behind the bundled nginx proxy: VITE_API_URL=/api/v1
